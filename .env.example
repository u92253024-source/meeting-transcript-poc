# mock: 不需金鑰；cloud: Google + AssemblyAI；deepgram-assembly: Deepgram 文字 + AssemblyAI 講者
# cloud-stt-only: 只有 Google；deepgram: 只有 Deepgram（A/B 測試用）
TRANSCRIPTION_MODE=mock
HOST=0.0.0.0
PORT=3001
DATA_DIR=./data

# Google Cloud Speech-to-Text V2（使用 Application Default Credentials）
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-southeast1
GOOGLE_CLOUD_RECOGNIZER=_
GOOGLE_STT_LANGUAGE=cmn-Hant-TW
GOOGLE_STT_MODEL=chirp_2

# AssemblyAI Streaming V3
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_MAX_SPEAKERS=10
ASSEMBLYAI_STREAMING_MODEL=whisper-rt
ASSEMBLYAI_BATCH_MODEL=universal-3-5-pro
# 僅供停止會議後的估價顯示；費率變動時請依官方定價調整
ASSEMBLYAI_BATCH_BASE_USD_PER_HOUR=0.21
ASSEMBLYAI_DIARIZATION_USD_PER_HOUR=0.02

# Deepgram Nova-3 (set TRANSCRIPTION_MODE=deepgram for a live Deepgram-only run)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=zh-TW
DEEPGRAM_KEYTERMS=國立政治大學,政大,教務處,學務處,包種茶節,四維堂,高教深耕,學分學程,微學程,跨域學習,教學發展中心,教發,師長,教務同仁,補助,師老兵疲
# 背景聲可能阻止 VAD 產生 speech_final；另以單字間隔、時長與字數限制切段
DEEPGRAM_UTTERANCE_END_MS=1000
DEEPGRAM_MAX_SEGMENT_MS=30000
DEEPGRAM_MAX_SEGMENT_CHARACTERS=160

# Gemini 僅用於會後產生易讀候選稿；管理者明確確認後才送出
GEMINI_API_KEY=
GEMINI_READABLE_MODEL=gemini-3.5-flash-lite

# 每場新會議會自動產生獨立觀看碼；此值只用於升級舊資料時的過渡觀看碼
VIEW_ACCESS_CODE=
# 首次啟動可由網頁設定管理密碼；若已設定此值，系統會將它雜湊後匯入本機資料庫
ADMIN_PASSWORD=
# 錄音檔保留天數；逐字稿、講者與易讀稿不會被此排程刪除
RECORDING_RETENTION_DAYS=30

# PDF 繁體中文字型；Windows 預設會自動使用微軟正黑體，可視需要覆寫
PDF_CJK_FONT=
PDF_CJK_BOLD_FONT=
